<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hr.algebra.controller.UserController"
      spacing="20"
      style="-fx-padding: 30; -fx-background-color: #f9f9f9;"
      prefWidth="500" prefHeight="550"
      alignment="TOP_CENTER">

   <Label text="My Account"
          style="-fx-font-size: 20; -fx-font-weight: bold;"/>

   <Separator/>

   <!-- Profilna slika -->
   <VBox alignment="CENTER" spacing="8">
      <ImageView fx:id="profileImageView"
                 fitWidth="120" fitHeight="120"
                 preserveRatio="true"
                 style="-fx-effect: dropshadow(gaussian, #aaa, 8, 0, 0, 2);"/>

      <Button text="Change profile picture"
              onAction="#onSetProfilePicture"
              style="-fx-background-color: #2196F3;
                       -fx-text-fill: white;
                       -fx-padding: 6 14;"/>

      <Label fx:id="imageStatusLabel" text=""
             style="-fx-text-fill: #777; -fx-font-size: 11;"/>
   </VBox>

   <Separator/>

   <!-- Podaci korisnika -->
   <GridPane hgap="15" vgap="12" alignment="CENTER">
      <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0"
             style="-fx-font-weight: bold;"/>
      <Label fx:id="usernameLabel" text=""
             GridPane.columnIndex="1" GridPane.rowIndex="0"/>

      <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="1"
             style="-fx-font-weight: bold;"/>
      <Label fx:id="roleLabel" text=""
             GridPane.columnIndex="1" GridPane.rowIndex="1"/>

      <Label text="New password:" GridPane.columnIndex="0" GridPane.rowIndex="2"
             style="-fx-font-weight: bold;"/>
      <PasswordField fx:id="newPasswordField"
                     promptText="Leave empty to keep current"
                     prefWidth="200"
                     GridPane.columnIndex="1" GridPane.rowIndex="2"/>

      <Label text="Confirm password:" GridPane.columnIndex="0" GridPane.rowIndex="3"
             style="-fx-font-weight: bold;"/>
      <PasswordField fx:id="confirmPasswordField"
                     promptText="Repeat new password"
                     prefWidth="200"
                     GridPane.columnIndex="1" GridPane.rowIndex="3"/>
   </GridPane>

   <!-- Gumbi -->
   <HBox spacing="12" alignment="CENTER">
      <Button text="Save changes"
              onAction="#onSaveChanges"
              style="-fx-background-color: #4CAF50;
                       -fx-text-fill: white;
                       -fx-padding: 8 20;
                       -fx-font-size: 13;"/>
      <Button text="Cancel"
              onAction="#onCancel"
              style="-fx-background-color: #9E9E9E;
                       -fx-text-fill: white;
                       -fx-padding: 8 20;
                       -fx-font-size: 13;"/>
   </HBox>

   <Label fx:id="statusLabel" text=""
          wrapText="true"
          style="-fx-font-size: 12;"/>

</VBox>