<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1013.0" prefWidth="988.0" style="-fx-padding: 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.controller.HeadphonesController">

    <!-- CENTAR - tablica -->
    <center>
        <TableView fx:id="headphonesTable" prefHeight="925.0" prefWidth="675.0" style="-fx-padding: 0 0 10 0;">
            <columns>
                <TableColumn fx:id="colName" prefWidth="160" text="Name" />
                <TableColumn fx:id="colBrand" prefWidth="100" text="Brand" />
                <TableColumn fx:id="colType" prefWidth="90" text="Type" />
                <TableColumn fx:id="colYear" prefWidth="70" text="Year" />
                <TableColumn fx:id="colPrice" prefWidth="90" text="Price(€)" />
                <TableColumn fx:id="colBattery" prefWidth="90" text="Battery (h)" />
                <TableColumn fx:id="colImpedance" prefWidth="90" text="Impedance" />
            </columns>
        </TableView>
    </center>

    <!-- DESNO - forma za unos/uređivanje -->
    <right>
        <ScrollPane fitToWidth="true" prefWidth="280" style="-fx-padding: 0 0 0 10;">
            <VBox prefHeight="921.0" prefWidth="270.0" spacing="8" style="-fx-padding: 5;">

                <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Headphone details" />

                <Label text="Name*" />
                <TextField fx:id="nameField" promptText="Model name " />

                <Label text="Year *" />
                <TextField fx:id="yearField" promptText="ex. 2023" />

                <Label text="Price (€) *" />
                <TextField fx:id="priceField" promptText="ex. 299.99" />

                <Label text="Impedance (Ω)*" />
                <TextField fx:id="impedanceField" promptText="ex. 32" />

                <Label text="Min. frequency (Hz)*" />
                <TextField fx:id="minFreqField" promptText="ex. 20" />

                <Label text="Max. frequency (Hz)*" />
                <TextField fx:id="maxFreqField" promptText="ex. 20000" />

                <Label text="Battery Life(h, 0=wired)*" />
                <TextField fx:id="batteryField" promptText="ex. 30" />

                <Label text="Brand*" />
                <ComboBox fx:id="brandCombo" maxWidth="Infinity" />

                <Label text="Type*" />
                <ComboBox fx:id="typeCombo" maxWidth="Infinity" />

                <Label text="Description" />
                <TextArea fx:id="descriptionArea" prefHeight="45.0" prefRowCount="3" prefWidth="260.0" wrapText="true" />

                <Label text="Technologies" />
                <ListView fx:id="technologiesListView" prefHeight="46.0" prefWidth="260.0" />

                <Label text="Uses" />
                <ListView fx:id="usesListView" prefHeight="41.0" prefWidth="260.0" />

                <Label fx:id="imageLabel" style="-fx-text-fill: #777;" text="No picture" />
                <Button maxWidth="Infinity" onAction="#onChooseImage" text="Choose picture" />

                <Separator />
                <!-- Gumbi za akcije -->
                <HBox spacing="5">
                    <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #607D8B; -fx-text-fill: white;" text="Clear" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#onSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#onDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Delete" HBox.hgrow="ALWAYS" />
                </HBox>

                <Button maxWidth="Infinity" onAction="#onExportXml" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Exportaj u XML" />

            </VBox>
        </ScrollPane>
    </right>
   <top>
      <VBox prefHeight="35.0" prefWidth="968.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Entities">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onHeadphones" text="Headphones" />
                        <MenuItem mnemonicParsing="false" onAction="#onBrands" text="Brands" />
                        <MenuItem mnemonicParsing="false" onAction="#onTypes" text="Types" />
                        <MenuItem mnemonicParsing="false" onAction="#onUses" text="Uses" />
                        <MenuItem mnemonicParsing="false" onAction="#onTechnologies" text="Technologies" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Views">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onMainMenu" text="Main menu" />
                        <MenuItem mnemonicParsing="false" onAction="#onCompareHeadphones" text="Compare headphones" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Account">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onAccountInfo" text="Account info" />
                        <MenuItem mnemonicParsing="false" onAction="#onLogOut" text="Log out" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
             <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Headphones" />
             <HBox alignment="CENTER_LEFT" spacing="10">
                 <TextField fx:id="searchField" prefWidth="220" promptText="search by name" />
                 <ComboBox fx:id="filterBrandCombo" prefWidth="160" promptText="Filter by brand" />
                 <ComboBox fx:id="filterTypeCombo" prefWidth="160" promptText="Filter by type" />
                 <Button onAction="#onShowAll" text="Show all" />
             </HBox>

         </children>
      </VBox>
   </top>

</BorderPane>
