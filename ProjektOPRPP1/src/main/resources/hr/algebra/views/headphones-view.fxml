<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="800.0" style="-fx-padding: 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.controller.HeadphonesController">
    <right>
        <ScrollPane fitToWidth="true" prefHeight="745.0" prefWidth="243.0" style="-fx-padding: 0 0 0 10;">
            <VBox alignment="CENTER" prefHeight="705.0" prefWidth="270.0" spacing="8" style="-fx-padding: 5;">
            <ImageView fx:id="headphoneImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />

                <Label fx:id="nameLabel" text="Name*" />

                <Label fx:id="yearLabel" text="Year *" />

                <Label fx:id="priceLabel" text="Price (€) *" />

                <Label fx:id="impedanceLabel" text="Impedance (Ω)*" />

                <Label fx:id="minFreqLabel" text="Min. frequency (Hz)*" />

                <Label fx:id="maxFreqLabel" text="Max. frequency (Hz)*" />

                <Label fx:id="batteryLabel" text="Battery Life(h, 0=wired)*" />

                <Label fx:id="brandLabel" text="Brand*" />

                <Label fx:id="typeLabel" text="Type*" />

                <Label fx:id="descLabel" text="Description*" />

                <Label fx:id="techLabel" text="Technologies*" />

                <Label fx:id="useLabel" text="Uses*" />
                <!-- Gumbi za akcije -->
                <HBox spacing="5">
                    <Button maxWidth="Infinity" onAction="#onClear" style="-fx-background-color: #607D8B; -fx-text-fill: white;" text="Clear" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#onEdit" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Edit" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#onDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Delete" HBox.hgrow="ALWAYS" />
                </HBox>

                <Button maxWidth="Infinity" onAction="#onExportXml" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Exportaj u XML" />

            </VBox>
        </ScrollPane>
    </right>
   <top>
      <VBox prefHeight="35.0" prefWidth="968.0" BorderPane.alignment="CENTER" />
       <fx:include source="top-navigation-view.fxml" />
   </top>
   <center>
      <VBox prefHeight="730.0" prefWidth="524.0" BorderPane.alignment="CENTER">
         <children>
             <HBox alignment="CENTER" spacing="10">
                 <TextField fx:id="searchField" prefHeight="25.0" prefWidth="175.0" promptText="search by name" />
                 <ComboBox fx:id="filterBrandCombo" prefHeight="25.0" prefWidth="117.0" promptText="Filter by brand" />
                 <ComboBox fx:id="filterTypeCombo" prefHeight="25.0" prefWidth="109.0" promptText="Filter by type" />
                 <Button onAction="#onShowAll" text="Show all" />
             </HBox>
            <TableView fx:id="headphonesTable" prefHeight="742.0" prefWidth="537.0">
              <columns>
                <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
                <TableColumn fx:id="colBrand" prefWidth="75.0" text="Brand" />
                  <TableColumn fx:id="colType" prefWidth="75.0" text="Type" />
                  <TableColumn fx:id="colImpedance" prefWidth="75.0" text="Impedance" />
                  <TableColumn fx:id="colPrice" prefWidth="75.0" text="Price" />
                  <TableColumn fx:id="colYear" prefWidth="75.0" text="Year" />
                  <TableColumn fx:id="colBattery" prefWidth="75.0" text="Battery" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <VBox prefHeight="0.0" prefWidth="780.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="currentUserLabel" />
         </children>
      </VBox>
   </bottom>

</BorderPane>
