<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.controller.TechnologyController">
   <center>
      <TableView fx:id="technologiesTable" prefHeight="358.0" prefWidth="422.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colID" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="colDesc" prefWidth="75.0" text="Description" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <right>
      <VBox alignment="CENTER" prefHeight="358.0" prefWidth="184.0" spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="nameLabel" text="Name *" />
            <Label fx:id="descLabel" text="Description *">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin></Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onClear" text="Clear" />
                  <Button mnemonicParsing="false" onAction="#onEdit" text="Edit" />
                  <Button mnemonicParsing="false" onAction="#onDelete" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
   <top>
      <VBox prefHeight="16.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Entities">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onHeadphones" text="Headphones" />
                        <MenuItem mnemonicParsing="false" onAction="#onBrands" text="Brands" />
                        <MenuItem mnemonicParsing="false" onAction="#onTypes" text="Types" />
                        <MenuItem mnemonicParsing="false" onAction="#onUses" text="Uses" />
                        <MenuItem mnemonicParsing="false" onAction="#onTechnologies" text="Technologies" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Views">
                  <items>
                        <MenuItem mnemonicParsing="false" onAction="#onMainMenu" text="Main menu" />
                    <MenuItem mnemonicParsing="false" onAction="#onCompareHeadphones" text="Compare Headphones" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Account">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onAccountInfo" text="Account info" />
                        <MenuItem mnemonicParsing="false" onAction="#onLogOut" text="Log out" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <TextField fx:id="searchField" promptText="search..." />
