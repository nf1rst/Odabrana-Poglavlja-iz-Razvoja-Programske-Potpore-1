                                    <Button mnemonicParsing="false" onAction="#onDeleteAllUsers" text="Delete All Users" />
                                    <CheckBox fx:id="editRightsCheckBox" mnemonicParsing="false" text="Allow user edit" />
                                 </children>
                                 <BorderPane.margin>
                                    <Insets right="5.0" />
                                 </BorderPane.margin>
                              </HBox>
                           </top>
                           <center>
                              <TableView fx:id="userTableView" prefHeight="344.0" prefWidth="700.0" BorderPane.alignment="CENTER">
