<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.controller.UseController">
   <top>
      <VBox prefHeight="30.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Entities">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onHeadphones" text="Headphones" />
                        <MenuItem mnemonicParsing="false" onAction="#onBrands" text="Brands" />
                        <MenuItem mnemonicParsing="false" onAction="#onTypes" text="Types" />
                        <MenuItem mnemonicParsing="false" onAction="#onUses" text="Uses" />
                        <MenuItem mnemonicParsing="false" onAction="#onTechnologies" text="Technologies" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Views">
                  <items>
                        <MenuItem mnemonicParsing="false" onAction="#onMainMenu" text="Main menu" />
                    <MenuItem mnemonicParsing="false" onAction="#onCompareHeadphones" text="Compare headphones" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Account">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onAccountInfo" text="Account info" />
                        <MenuItem mnemonicParsing="false" onAction="#onLogOut" text="Log out" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <TextField fx:id="searchField" promptText="search uses" />
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="useTable" prefHeight="255.0" prefWidth="600.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colID" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <right>
      <VBox alignment="TOP_CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="340.0" prefWidth="188.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="nameLabel" text="Name*" />
            <HBox alignment="CENTER" prefHeight="71.0" prefWidth="188.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onClear" text="Clear">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Button>
                  <Button mnemonicParsing="false" onAction="#onEdit" text="Edit" />
                  <Button mnemonicParsing="false" onAction="#onDelete" text="Delete" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </HBox>
            <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="148.0" text="Export to XML" />
         </children>
         <BorderPane.margin>
            <Insets top="15.0" />
         </BorderPane.margin>
      </VBox>
   </right>
</BorderPane>
