<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.controller.TypeController">
   
   <center>
      <TableView fx:id="typeTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colID" prefWidth="97.0" text="ID" />
          <TableColumn fx:id="colName" prefWidth="173.0" text="Name" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <right>
      <VBox prefHeight="379.0" prefWidth="193.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Type Details" textAlignment="CENTER" />
            <Label text="Name *" />
            <TextField fx:id="nameField" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onClear" text="Clear" />
                  <Button mnemonicParsing="false" onAction="#onSave" text="Save" />
                  <Button mnemonicParsing="false" onAction="#onDelete" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>


   <bottom>
      <Label fx:id="currentUserLabel" text="User: " BorderPane.alignment="TOP_LEFT" />
   </bottom>
   <top>
      <VBox prefHeight="9.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Entities">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onHeadphones" text="Headphones" />
                        <MenuItem mnemonicParsing="false" onAction="#onBrands" text="Brands" />
                        <MenuItem mnemonicParsing="false" onAction="#onTypes" text="Types" />
                        <MenuItem mnemonicParsing="false" onAction="#onUses" text="Uses" />
                        <MenuItem mnemonicParsing="false" onAction="#onTechnologies" text="Technologies" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Views">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onMainMenu" text="Main menu" />
                        <MenuItem mnemonicParsing="false" onAction="#onCompareHeadphones" text="Compare headphones" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Account">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onAccountInfo" text="Account info" />
                        <MenuItem mnemonicParsing="false" onAction="#onLogOut" text="Log out" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <TextField fx:id="searchField" />
         </children>
      </VBox>
   </top>
</BorderPane>
